# ==============================================================================
# Balance Environment Configuration (.env.example)
# Copy this file to .env and adjust values for your local environment:
#   cp .env.example .env
# ==============================================================================

# Server configuration
PORT=8080
DATA_DIR=./data

# Google Gemini API configuration
# Used by the Formula AI Assistant to generate sandboxed Lua formulas
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# GoCardless Bank Integration API configuration
# Used for Open Banking account linking and transaction fetching
GOCARDLESS_SECRET_ID=your_gocardless_secret_id_here
GOCARDLESS_SECRET_KEY=your_gocardless_secret_key_here
GOCARDLESS_ENVIRONMENT=sandbox
# Optional redirect URL after bank authorization
GOCARDLESS_REDIRECT_URL=http://localhost:8080/budgets/integrations/gocardless/callback
