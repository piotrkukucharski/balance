# ==============================================================================
# Balance Environment Configuration (.env.example)
# Copy this file to .env and adjust values for your local environment:
#   cp .env.example .env
# ==============================================================================

# Server configuration
PORT=8080
DATA_DIR=./data
# Public user registration toggle (default: true). Set to false to disable public signups.
ALLOW_REGISTRATION=true

# Google Gemini API configuration
# Used by the Formula AI Assistant to generate sandboxed Lua formulas and Structure AI Assistant
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
# HTTP client timeout in seconds for Gemini API requests (default: 90)
GEMINI_TIMEOUT_SECONDS=90
# Optional thinking token budget for thinking models (e.g. 0 to disable thinking for faster responses)
# GEMINI_THINKING_BUDGET=0

# GoCardless Bank Integration API configuration
# Used for Open Banking account linking and transaction fetching
GOCARDLESS_SECRET_ID=your_gocardless_secret_id_here
GOCARDLESS_SECRET_KEY=your_gocardless_secret_key_here
GOCARDLESS_ENVIRONMENT=sandbox
# Optional redirect URL after bank authorization
GOCARDLESS_REDIRECT_URL=http://localhost:8080/budgets/integrations/gocardless/callback

# Demo fixtures credentials configuration
FIXTURES_DEMO_LOGIN=demo@balance.local
FIXTURES_DEMO_PASSWORD=Password123!

# Todo (Vikunja) task management API configuration
# Used by dev:worktree:create to resolve task titles into worktree branch names
VIKUNJA_API_URL=
VIKUNJA_API_TOKEN=your_vikunja_token_here
VIKUNJA_PROJECT_ID=

